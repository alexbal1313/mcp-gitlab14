      "path": "src",
      "extension": "java"
    },
    "steps": [
      {
        "method": "GET",
        "path": "/api/v4/projects/team%2Fproject",
        "query": {},
        "response": {
          "web_url": "https://gitlab.example.com/team/project",
          "default_branch": "main"
        }
      },
      {
        "method": "GET",
        "path": "/api/v4/projects/team%2Fproject/search",
        "query": {
          "scope": "blobs",
          "search": "hello path:src extension:java",
          "ref": "main",
          "per_page": "20"
        },
        "response": [
          {
            "path": "src/App.java",
            "ref": "main",
            "startline": 7,
            "data": "hello world"
          }
        ]
      }
